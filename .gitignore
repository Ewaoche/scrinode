# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
.next/
out/
*.tsbuildinfo

# Turborepo
.turbo/

# Environment — never commit secrets
.env
.env.local
.env.*.local
!.env.example

# Test output
coverage/
playwright-report/
test-results/
blob-report/
.playwright/

# Editor
.vscode/*
!.vscode/extensions.json
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Vercel
.vercel

# Bible source staging — downloaded publisher archives and parsed output.
# ~650MB for all 34 translations. Reproducible with
# `node packages/ingest/dist/cli.js fetch parse`, and the canonical copy
# lives in object storage, so it is never committed.
.ingest/

# Vitest's JSON reporter output. Written when --reporter=json is used, which
# scripts/assert-db-tests-ran.mjs does; it is a build artifact, not a report
# anyone reads from the repository.
.vitest/
