# Copy to .env.local and fill in. Never commit real values.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# MongoDB Atlas connection string.
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"

# Database name. Use a non-production database for development.
MONGODB_DB="scrinode_dev"

# ---------------------------------------------------------------------------
# Reader authentication (apps/web) — Auth.js / NextAuth v4
# ---------------------------------------------------------------------------
NEXTAUTH_URL="http://localhost:3000"

# Signs session tokens. Must be at least 32 characters — a weak secret means
# forgeable sessions, and the app refuses to serve auth requests without one.
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# Google OAuth — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email (magic link) sign-in via Resend.
# Both must be set together, or neither. At least one provider (Google or
# email) must be configured.
EMAIL_FROM="noreply@scrinode.com"
RESEND_API_KEY=""

# ---------------------------------------------------------------------------
# API (apps/api)
# ---------------------------------------------------------------------------
API_PORT="4000"

# ---------------------------------------------------------------------------
# Backoffice (apps/backoffice)
# ---------------------------------------------------------------------------
# Admin identity is a SEPARATE system from reader identity (AGENTS.md §27).
# Its secrets are added in Stage 2.
BACKOFFICE_PORT="3001"
