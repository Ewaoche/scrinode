# Copy to .env.local and fill in. Never commit real values.
#
# Every variable the code reads is listed here. If you add a new one, add it
# here too — and to the schema in @scrinode/validation, so a misconfigured
# deploy fails at boot rather than at runtime under load.
#
# Variables are grouped by which app needs them. Some are shared.

# ---------------------------------------------------------------------------
# Shared
# ---------------------------------------------------------------------------

# development | test | production
# Set automatically by Next.js and by the platform; override only when you
# genuinely need to. Affects connection pooling and cookie security.
NODE_ENV="development"

# ---------------------------------------------------------------------------
# Database — needed by @scrinode/api and @scrinode/web
# ---------------------------------------------------------------------------

# PostgreSQL connection string. A secret: never logged, never committed.
#
# Local development runs the container in docker-compose.yml:
#   postgres://scrinode:scrinode_dev_password@localhost:5432/scrinode_dev
#
# On the droplet the host is the compose service name, not localhost.
DATABASE_URL="postgres://scrinode:scrinode_dev_password@localhost:5432/scrinode_dev"

# Require TLS to the database. Leave false when the app and Postgres share a
# private network, as they do on the droplet; set true for a managed database
# reached across a network.
DATABASE_SSL="false"

# Maximum pooled connections per process. Postgres allocates a backend per
# connection, so raising this without raising the server's max_connections
# exhausts it rather than improving throughput.
DATABASE_POOL_MAX="10"

# Database used by integration tests. Separate from DATABASE_URL on purpose:
# these tests create and drop schemas, and must never be pointed at a
# development database by a variable that is already set for other reasons.
# Unset means database integration tests skip rather than fail.
TEST_DATABASE_URL="

# ---------------------------------------------------------------------------
# API — @scrinode/api (NestJS)
# ---------------------------------------------------------------------------

API_PORT="4000"

# Origins permitted to call the API, comma-separated. A wildcard is rejected:
# the API serves credentialed requests, so every caller is listed explicitly.
# Each entry must be an absolute http(s) origin with no path or trailing slash.
# Set this in every deployed environment — the default only covers local apps.
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"

# ---------------------------------------------------------------------------
# Web — @scrinode/web (Next.js, public reader)
# ---------------------------------------------------------------------------

# Base URL the browser uses to reach the API. NEXT_PUBLIC_ means this is
# inlined into the client bundle, so it must never hold a secret.
#
# Defaults to http://localhost:4000 when unset — which is correct locally and
# wrong everywhere else. Set it explicitly in every deployed environment.
NEXT_PUBLIC_API_URL="http://localhost:4000"

# --- Reader authentication (Auth.js / NextAuth v4) -------------------------
# Reader identity only. Admin identity is a separate system with its own
# secrets (AGENTS.md §27.2); those arrive with the backoffice in Stage 2.

# Absolute URL of this app. Must match the deployed origin, or OAuth
# callbacks will not return.
NEXTAUTH_URL="http://localhost:3000"

# Signs session tokens. At least 32 characters — a weak secret means
# forgeable sessions, and the app refuses to serve auth requests without a
# valid one.
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# At least one sign-in provider must be configured. Each provider's variables
# must be set together or omitted together; half a pair fails validation.

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email (magic link) sign-in via Resend.
EMAIL_FROM="noreply@scrinode.com"
RESEND_API_KEY=""

# ---------------------------------------------------------------------------
# Backoffice — @scrinode/backoffice (internal admin)
# ---------------------------------------------------------------------------
# Not yet built. Admin identity is a SEPARATE security domain from reader
# identity: separate collections, sessions, cookie and domain (AGENTS.md
# §27.2, §27.3). Its secrets are added in Stage 2 and must never be shared
# with the reader app.

BACKOFFICE_PORT="3001"

# ---------------------------------------------------------------------------
# Bible ingestion — @scrinode/ingest
# ---------------------------------------------------------------------------
# Used only by the ingestion CLI, never by a running application. Source text
# is staged to object storage so the licensed bytes stay provable and a
# re-import never depends on a publisher staying online (AGENTS.md §21).
#
#   pnpm --filter @scrinode/ingest run build
#   node packages/ingest/dist/cli.js fetch      # download publisher archives
#   node packages/ingest/dist/cli.js parse      # USFM -> verse JSON
#   node packages/ingest/dist/cli.js upload     # -> DigitalOcean Spaces
#   node packages/ingest/dist/cli.js load       # -> MongoDB
#
# Staging directory for downloaded and parsed source. Large (~650MB for all
# 34 translations) and git-ignored.
INGEST_DIR=".ingest"

# DigitalOcean Spaces. The endpoint is region-specific; the region must match
# it. Keys need write access to the bucket and nothing else.
DO_SPACES_ENDPOINT="https://fra1.digitaloceanspaces.com"
DO_SPACES_REGION="fra1"
DO_SPACES_BUCKET=""
DO_SPACES_KEY=""
DO_SPACES_SECRET=""

# The ingestion CLI writes to DATABASE_URL, declared under Database above.
# Deliberately not redeclared here: a second assignment would silently
# override the first.

# Voyage AI — embeddings stored in pgvector (AGENTS.md §20).
# Used only by the ingestion CLI's `embed` stage, never by a running app.
# Key from https://dashboard.voyageai.com/organization/api-keys
VOYAGE_API_KEY=""
